	id = {Bates2015},
	isbn = {1432-122X},
	journal = {Informatik-Spektrum},
	number = {2},
	pages = {111--127},
	title = {Electrical Grid and Supercomputing Centers: An Investigative Analysis of Emerging Opportunities and Challenges},
	url = {https://doi.org/10.1007/s00287-014-0850-0},
	volume = {38},
	year = {2015},
